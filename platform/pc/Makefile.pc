# platform/pc/Makefile.pc — native PC host build (GBA Makefile untouched).
#
# Layout per project convention:
#   build in  build/bin/  (objects, linked binary, host tools)
#   run from  build/      (staged exe + runtime files)
#
# Usage:
#   make -f platform/pc/Makefile.pc pc          # build + stage (default)
#   make -f platform/pc/Makefile.pc run         # build + stage + 60-frame smoke
#   make -f platform/pc/Makefile.pc tools       # preproc + gbagfx host tools
#   make -f platform/pc/Makefile.pc assets-pc   # derived assets for host compile
#   make -f platform/pc/Makefile.pc pc-syntax   # all 544 src/*.c via preproc pipe
#   make -f platform/pc/Makefile.pc clean-pc    # remove only PC outputs
#
# Toolchain: host clang (no arm-none-eabi, no agbcc, no cmake needed).
# SDL2 is optional: if `sdl2-config` exists we link it and define HAVE_SDL2,
# otherwise the binary runs headless (framebuffer + --dump frame.ppm).
# libpng: needed for full gbagfx (PNG->4bpp). If missing, we download+build
# libpng 1.6.x statically into build/deps/prefix (no sudo, no brew).
ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))../..)
BUILD_DIR := $(ROOT)/build
BIN_DIR := $(BUILD_DIR)/bin
OBJ_DIR := $(BIN_DIR)/obj
BIN := $(BIN_DIR)/pmd-red-pc
STAGED := $(BUILD_DIR)/pmd-red-pc

DEPS := $(BUILD_DIR)/deps
PREFIX := $(DEPS)/prefix
LIBPNG_VER := 1.6.47
LIBPNG_SRC := $(DEPS)/src/libpng-$(LIBPNG_VER)
LIBPNG_LIB := $(PREFIX)/lib/libpng.a
LIBPNG_INC := $(PREFIX)/include/png.h

PREPROC := $(ROOT)/tools/preproc/preproc
GBAGFX_FULL := $(BIN_DIR)/gbagfx
GBAGFX_NOPNG := $(BIN_DIR)/gbagfx-nopng

# Windows/MSYS2 uses the mingw-w64-i686 gcc (32-bit host, matching GBA pointer
# layout); other hosts default to clang. Override with CC= on the command line.
ifeq ($(OS),Windows_NT)
CC ?= gcc
else
CC ?= clang
endif
# ImGui is C++; link the C++ runtime in via the C++ driver.
ifeq ($(OS),Windows_NT)
CXX ?= g++
else
CXX ?= clang++
endif
PYTHON ?= python3
ASSET_JOBS ?= 1
CFLAGS := -std=gnu89 -Wall -Wextra -O2 -DPLATFORM_PC -DMODERN=2
CPPFLAGS := -I$(ROOT)/include -I$(ROOT)/platform/pc
LDFLAGS := -lm

HAVE_SDL := $(shell command -v sdl2-config >/dev/null 2>&1 && echo yes || echo no)
ifeq ($(HAVE_SDL),yes)
CFLAGS += -DHAVE_SDL2 $(shell sdl2-config --cflags)
LDFLAGS += $(shell sdl2-config --libs)
endif
ifeq ($(OS),Windows_NT)
LDFLAGS += -lcomdlg32 -Wl,--disable-dynamicbase
# ImGui is C++ linked via the g++ driver; statically bind the GCC/libstdc++/
# winpthread runtimes so the exe's only DLL dependency is SDL2.dll. The driver
# re-adds -lwinpthread after our flags, so force the static archive in with
# --whole-archive to satisfy the libstdc++ pthread references early.
LDFLAGS += -static-libgcc -static-libstdc++
LDFLAGS += -Wl,-Bstatic -Wl,--whole-archive -lwinpthread -Wl,--no-whole-archive -Wl,-Bdynamic
endif

# Dear ImGui (git submodule platform/pc/imgui, pinned tag v1.92.9b).
IMGUI_DIR := $(ROOT)/platform/pc/imgui
ifeq ($(HAVE_SDL),yes)
ifneq ($(wildcard $(IMGUI_DIR)/imgui.h),)
UI_SRCS := $(IMGUI_DIR)/imgui.cpp \
           $(IMGUI_DIR)/imgui_draw.cpp \
           $(IMGUI_DIR)/imgui_tables.cpp \
           $(IMGUI_DIR)/imgui_widgets.cpp \
           $(IMGUI_DIR)/backends/imgui_impl_sdl2.cpp \
           $(IMGUI_DIR)/backends/imgui_impl_sdlrenderer2.cpp \
           $(ROOT)/platform/pc/ui_pc.cpp
CXXFLAGS := -O2 -std=c++17 -DPLATFORM_PC -DMODERN=2 -DHAVE_SDL2 \
            $(shell sdl2-config --cflags) \
            -idirafter $(ROOT)/include \
            -I$(IMGUI_DIR) -I$(IMGUI_DIR)/backends
else
$(error platform/pc/imgui is a git submodule; run `git submodule update --init --recursive` first)
endif
else
UI_SRCS :=
endif

# libpng for the full gbagfx (PNG decode during asset generation). Prefer a
# system/pkg-config install (e.g. MSYS2 mingw-w64-x86_64-libpng); only fall
# back to downloading and building a static libpng under build/deps/prefix.
ifeq ($(shell pkg-config --exists libpng 2>/dev/null && echo yes),yes)
GBAGFX_PNG_CPPFLAGS := $(shell pkg-config --cflags libpng)
GBAGFX_PNG_LDLIBS := $(shell pkg-config --libs libpng)
GBAGFX_PNG_DEPS :=
else
GBAGFX_PNG_CPPFLAGS := -DPNG_SKIP_SETJMP_CHECK -I$(PREFIX)/include
GBAGFX_PNG_LDLIBS := $(LIBPNG_LIB) -lz
GBAGFX_PNG_DEPS := $(LIBPNG_LIB)
endif

PC_SRCS := $(ROOT)/platform/pc/cpu_pc.c \
           $(ROOT)/platform/pc/video_pc.c \
           $(ROOT)/platform/pc/input_pc.c \
           $(ROOT)/platform/pc/audio_pc.c \
           $(ROOT)/platform/pc/save_pc.c \
           $(ROOT)/platform/pc/config_pc.c \
           $(ROOT)/platform/pc/rom_load.c \
           $(ROOT)/platform/pc/rom_load_stubs.c \
           $(ROOT)/platform/pc/crash_win.c \
           $(ROOT)/platform/pc/stubs_pc.c \
           $(ROOT)/platform/pc/boot_pc.c \
           $(ROOT)/platform/pc/main_pc.c
PC_SRCS += $(UI_SRCS)
PC_OBJS := $(patsubst $(ROOT)/%.c,$(OBJ_DIR)/%.o,$(filter %.c,$(PC_SRCS))) \
           $(patsubst $(ROOT)/%.cpp,$(OBJ_DIR)/%.o,$(filter %.cpp,$(PC_SRCS)))
# Game binary swaps the smoke entry for the real-init entry and links the
# generated rom_slices_all.o/blob_addrs.o instead of the stub tables.
# m4a_port.o (the real m4a player) is game-link only: the smoke binary has no
# song data (audio_data.o) for it to reference.
GAME_PC_OBJS := $(filter-out $(OBJ_DIR)/platform/pc/main_pc.o $(OBJ_DIR)/platform/pc/rom_load_stubs.o,$(PC_OBJS)) $(OBJ_DIR)/platform/pc/main_game.o $(OBJ_DIR)/platform/pc/m4a_port.o

# Host compile flags for game sources (mirrors the GBA .c rule minus agbcc):
# GBA: $(CPP) $(CPPFLAGS) $< | $(PREPROC) charmap.txt | $(CC1)
# PC:  clang -E $(GAME_CPPFLAGS) $< | $(PREPROC) charmap.txt | clang -c -x c
# NONMATCHING/NOMATCHING select the portable fallbacks for ARM register-bound
# locals (see math.c, ground_*.c); PLATFORM_PC guards the remaining raw asm.
GAME_CPPFLAGS := -std=gnu89 -DPLATFORM_PC -DMODERN=2 -DNONMATCHING -DNOMATCHING -iquote include -Iinclude -Iplatform/pc
GAME_CFLAGS := -std=gnu89 -g -O2 -DPLATFORM_PC -DMODERN=2 -DNONMATCHING -DNOMATCHING
# GAME_ASAN=1 builds the host binary with AddressSanitizer (macOS arm64 OK).
# Slow rebuild, but pinpoints wild writes from GBA-isms (VRAM mirrors,
# truncated pointers) with exact stack traces.
ifeq ($(GAME_ASAN),1)
GAME_CFLAGS += -fsanitize=address -fno-omit-frame-pointer
GAME_LDFLAGS := -fsanitize=address
endif

# Game sources linked into the host binary (recursive: game logic + data tables).
# Excluded: m4a.c (ARM mixer; audio_pc is mute-first until the sequencer lands),
# main.c (AgbMain/Hang boot replaced by platform/pc/main_pc.c).
GAME_EXCLUDE := $(ROOT)/src/m4a.c $(ROOT)/src/main.c
GAME_SRCS := $(filter-out $(GAME_EXCLUDE),$(wildcard $(ROOT)/src/*.c) $(wildcard $(ROOT)/src/data/*.c) $(wildcard $(ROOT)/src/data/*/*.c))
GAME_OBJ_DIR := $(OBJ_DIR)/game
GAME_OBJS := $(patsubst $(ROOT)/%.c,$(GAME_OBJ_DIR)/%.o,$(GAME_SRCS))

# Blob sources: data/*.s translated to host C by gen_blobs.py (typed File /
# FileArchive / SiroArchive / byte-blob emission). sound_data.s waits for the
# audio backend; pksdir_*.s carry no symbols.
#
# BASEROM_S blobs contain .incbin "baserom.gba", off, size directives: they are
# assembled with those replaced by .space (zero-filled), emitted as WRITABLE
# arrays, and their regions are filled at runtime from the user's own ROM dump
# (platform/pc/rom_load.c + rom_slices_all.c). The port never embeds ROM data.
BLOB_S := dungeon_sbin system_sbin credits1 unk_data \
  unk_9D02950 \
  data_80B9BB0 data_80E7D40 data_8109D10 data_810AE24_2 data_8115F5C_3_ \
  monster_sbin
BASEROM_S := titlemenu_sbin unk_96BD7AC unk_98589A4 unk_9E7EB08 unk_9fbd5d0
GEN_DIR := $(BIN_DIR)/gen
BLOB_IS := $(patsubst %,$(GEN_DIR)/%.i.s,$(BLOB_S))
BLOB_CS := $(patsubst %,$(GEN_DIR)/blobs_%.c,$(BLOB_S))
BLOB_OBJS := $(patsubst %,$(GAME_OBJ_DIR)/blobs_%.o,$(BLOB_S))
BASEROM_ARM := $(patsubst %,$(GEN_DIR)/arm/%.o,$(BASEROM_S))
BASEROM_CS := $(patsubst %,$(GEN_DIR)/blobs_%.c,$(BASEROM_S))
BASEROM_OBJS := $(patsubst %,$(GAME_OBJ_DIR)/blobs_%.o,$(BASEROM_S))
ROMSLICES_C := $(GEN_DIR)/rom_slices_all.c
ROMSLICES_H := $(GEN_DIR)/rom_slices_all.h
ROMSLICES_OBJ := $(GAME_OBJ_DIR)/rom_slices_all.o
SLICES_JSON := $(GEN_DIR)/baserom_slices.json
BLOB_ARM := $(patsubst %,$(GEN_DIR)/arm/%.o,$(BLOB_S))
ALL_BLOB_ARM := $(BLOB_ARM) $(BASEROM_ARM)
BLOBADDRS_C := $(GEN_DIR)/blob_addrs.c
BLOBADDRS_H := $(GEN_DIR)/blob_addrs.h
BLOBADDRS_OBJ := $(GAME_OBJ_DIR)/blob_addrs.o
# Host audio data: songs/voices/waves parsed from sound/ by gen_audio.py
# (pure-python text parse of the m4a DSL; no ARM toolchain needed).
AUDIO_GEN_C := $(GEN_DIR)/audio_data.c
AUDIO_GEN_OBJ := $(GAME_OBJ_DIR)/audio_data.o
AUDIO_SRCS := $(ROOT)/MPlayDef.s $(ROOT)/VoiceDef.s \
  $(ROOT)/sound/song_table.inc $(ROOT)/sound/voice_groups.inc \
  $(ROOT)/sound/waves.inc $(ROOT)/sound/gb_waves.inc \
  $(wildcard $(ROOT)/sound/songs/*.s) \
  $(wildcard $(ROOT)/sound/voicegroups/*.s) \
  $(wildcard $(ROOT)/sound/wave/*.s)
# ARM GNU toolchain used only to preprocess/assemble the data/*.s blobs into
# .o files that gen_blobs.py turns into host C. Auto-detect any flavor under
# build/deps (darwin-arm64, mingw-w64-i686, ...); override ARM_TC= on the
# command line or install arm-none-eabi tools on PATH as a fallback.
ARM_TC := $(firstword $(wildcard $(DEPS)/arm-gnu-toolchain-*/bin))
ifneq ($(strip $(ARM_TC)),)
ARM_CPP := $(ARM_TC)/arm-none-eabi-cpp
ARM_AS := $(ARM_TC)/arm-none-eabi-as
else
ARM_CPP := arm-none-eabi-cpp
ARM_AS := arm-none-eabi-as
endif

.PHONY: pc build stage run tools assets-pc pc-syntax blobs audio-data game-link stage-game clean-pc

pc: build stage

build: $(BIN)

# PC-backend objects. project include/ is added with -idirafter (not -I) so
# the game's include/strings.h never shadows the host string.h/strings.h that
# SDL's SDL_stdinc.h pulls in as <strings.h>. Game objects (below) still use
# -I because they need the game's own cross-includes to win.
PC_CPPFLAGS := $(filter-out -I$(ROOT)/include,$(CPPFLAGS)) -idirafter $(ROOT)/include
$(OBJ_DIR)/%.o: $(ROOT)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(PC_CPPFLAGS) -c $< -o $@

# ImGui core + backends + the overlay (C++); the settings UI lives in ui_pc.cpp.
$(OBJ_DIR)/%.o: $(ROOT)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(BIN): $(PC_OBJS)
	@mkdir -p $(BIN_DIR)
	$(CXX) $(PC_OBJS) -o $@ $(LDFLAGS)
	@echo "built $@ (sdl: $(HAVE_SDL))"

# ---- Full game link: real game objects + generated blobs + PC backends ----
# game-link proves every game module links against the HAL. The smoke main
# (main_pc.c) is still the entry; GameLoop_Async plugs in next. Objects go in
# a response file (`@...rsp`) because 700+ objects exceed the Windows command
# line limit (~32k chars); cygpath converts the MSYS paths to mixed form that
# the native mingw clang driver can parse directly.
GAME_LINK_OBJS := $(GAME_OBJS) $(BLOB_OBJS) $(BASEROM_OBJS) $(ROMSLICES_OBJ) $(BLOBADDRS_OBJ) $(AUDIO_GEN_OBJ) $(GAME_PC_OBJS)
game-link: tools assets-pc blobs audio-data $(GAME_OBJS) $(BLOB_OBJS) $(BASEROM_OBJS) $(ROMSLICES_OBJ) $(BLOBADDRS_OBJ) $(AUDIO_GEN_OBJ) $(GAME_PC_OBJS)
	@mkdir -p $(BIN_DIR)
	@printf '%s\n' $(GAME_LINK_OBJS) | sed 's|^/\([a-zA-Z]\)/|\1:/|' > $(BIN_DIR)/game_link.rsp
	$(CXX) @$(BIN_DIR)/game_link.rsp -o $(BIN_DIR)/pmd-red-game $(LDFLAGS) $(GAME_LDFLAGS)
	@echo "linked $(BIN_DIR)/pmd-red-game"

# ---- Host audio data (chunk 1 of PC audio) ----
# gen_audio.py parses sound/ (m4a DSL) into $(GEN_DIR)/audio_data.c, which
# defines the real gSongTable (940 entries) + song/voice/wave tables for the
# host player (platform/pc/audio_data.h). Regenerates only when sound/ or the
# script changes.
audio-data: $(AUDIO_GEN_C)
	@echo "audio-data: $(AUDIO_GEN_C)"
$(AUDIO_GEN_C): $(ROOT)/platform/pc/tools/gen_audio.py $(ROOT)/platform/pc/audio_data.h $(AUDIO_SRCS)
	@mkdir -p $(GEN_DIR)
	@cd $(ROOT) && $(PYTHON) platform/pc/tools/gen_audio.py --root . --out $(AUDIO_GEN_C)
$(AUDIO_GEN_OBJ): $(AUDIO_GEN_C)
	@mkdir -p $(GAME_OBJ_DIR)
	$(CC) $(GAME_CFLAGS) -I$(ROOT)/include -I$(ROOT)/platform/pc -c $< -o $@

$(GAME_OBJ_DIR)/%.o: $(ROOT)/%.c $(PREPROC)
	@mkdir -p $(dir $@)
	@$(CC) -E $(GAME_CPPFLAGS) -I$(ROOT)/include $< -o $(GAME_OBJ_DIR)/$*.i 2>/dev/null
	@$(PREPROC) $(GAME_OBJ_DIR)/$*.i $(ROOT)/charmap.txt > $(GAME_OBJ_DIR)/$*.p
	@$(CC) $(GAME_CFLAGS) -I$(ROOT)/include -I$(ROOT)/platform/pc -c -x c $(GAME_OBJ_DIR)/$*.p -o $@
	@rm -f $(GAME_OBJ_DIR)/$*.i $(GAME_OBJ_DIR)/$*.p

# Keep intermediates (cpp.s/i.s/arm.o): regenerating dungeon blobs is slow.
.PRECIOUS: $(GEN_DIR)/%.cpp.s $(GEN_DIR)/%.i.s $(GEN_DIR)/arm/%.o

# Blob pipeline per data/*.s: arm-cpp + preproc + arm-as, then gen_blobs.py.
# GBA flags mirrored (agbcc include, nostdinc) so expansion matches the ROM.
# baserom blobs are assembled with .incbin "baserom.gba", off, size replaced by
# .space size (zero-fill; the runtime ROM loader fills them) so the build needs
# no ROM.
$(GEN_DIR)/%.cpp.s: $(ROOT)/data/%.s
	@mkdir -p $(GEN_DIR)
	$(ARM_CPP) -x assembler-with-cpp -iquote $(ROOT)/include -I$(ROOT)/tools/agbcc/include -nostdinc -undef -std=gnu89 $< -o $@
$(GEN_DIR)/%.i.s: $(GEN_DIR)/%.cpp.s $(PREPROC)
	@cd $(ROOT) && $(PREPROC) $(GEN_DIR)/$*.cpp.s charmap.txt > $(GEN_DIR)/$*.i.s
$(GEN_DIR)/arm/%.o: $(GEN_DIR)/%.i.s
	@mkdir -p $(GEN_DIR)/arm
	@if [ "$(filter $*,$(BASEROM_S))" = "$*" ]; then \
	  sed -E 's/\.incbin "baserom\.gba", (0x[0-9A-Fa-f]+), (0x[0-9A-Fa-f]+)/.space \2/g' "$<" > "$(GEN_DIR)/$*.ass.s"; \
	  $(ARM_AS) -mcpu=arm7tdmi --defsym MODERN=0 "$(GEN_DIR)/$*.ass.s" -o "$@"; \
	else \
	  $(ARM_AS) -mcpu=arm7tdmi --defsym MODERN=0 "$<" -o "$@"; \
	fi
$(GEN_DIR)/blobs_%.c: $(GEN_DIR)/arm/%.o $(ROOT)/platform/pc/tools/gen_blobs.py $(ROOT)/platform/pc/tables.json
	@cd $(ROOT) && python3 platform/pc/tools/gen_blobs.py $(GEN_DIR)/arm/$*.o -o $(GEN_DIR) --toolchain $(ARM_TC) --prefix '' --tables platform/pc/tables.json --fixup-log $(GEN_DIR)/fixups_$*.txt
$(GAME_OBJ_DIR)/blobs_%.o: $(GEN_DIR)/blobs_%.c
	@mkdir -p $(GAME_OBJ_DIR)
	$(CC) $(GAME_CFLAGS) -I$(ROOT)/include -I$(ROOT)/platform/pc -c $< -o $@

# baserom slices metadata: which (romOffset,size) regions each baserom blob
# extracts, in .rodata order. Consumed by gen_blobs.py (--baserom).
$(SLICES_JSON): $(addprefix $(ROOT)/data/,$(addsuffix .s,$(BASEROM_S))) $(ROOT)/platform/pc/tools/gen_slices.py
	@mkdir -p $(GEN_DIR)
	@cd $(ROOT) && python3 platform/pc/tools/gen_slices.py data --out $(SLICES_JSON) $(BASEROM_S)

# baserom blobs + the combined runtime ROM-slice manifest, all from one
# gen_blobs invocation so the manifest sees every slice.
$(BASEROM_CS) $(ROMSLICES_C) $(ROMSLICES_H): $(BASEROM_ARM) $(SLICES_JSON) $(ROOT)/platform/pc/tools/gen_blobs.py $(ROOT)/platform/pc/tables.json
	@cd $(ROOT) && python3 platform/pc/tools/gen_blobs.py $(BASEROM_ARM) -o $(GEN_DIR) --toolchain $(ARM_TC) --prefix '' --tables platform/pc/tables.json --baserom $(SLICES_JSON) --fixup-log $(GEN_DIR)/fixups_baserom.txt
$(GAME_OBJ_DIR)/rom_slices_all.o: $(ROMSLICES_C) $(ROMSLICES_H)
	@mkdir -p $(GAME_OBJ_DIR)
	$(CC) $(GAME_CFLAGS) -I$(ROOT)/include -I$(ROOT)/platform/pc -c $< -o $@

# GBA-address registry: every blob symbol's 0x08xxxxxx ROM address mapped to its
# host array. One gen_blobs invocation over ALL blob objects.
$(BLOBADDRS_C) $(BLOBADDRS_H): $(ALL_BLOB_ARM) $(ROOT)/platform/pc/tools/gen_blobs.py
	@cd $(ROOT) && python3 platform/pc/tools/gen_blobs.py $(ALL_BLOB_ARM) -o $(GEN_DIR) --toolchain $(ARM_TC) --addresses $(GEN_DIR)/blob_addrs
$(GAME_OBJ_DIR)/blob_addrs.o: $(BLOBADDRS_C) $(BLOBADDRS_H)
	@mkdir -p $(GAME_OBJ_DIR)
	$(CC) $(GAME_CFLAGS) -I$(ROOT)/include -I$(ROOT)/platform/pc -c $< -o $@

blobs: $(BLOB_CS) $(BASEROM_CS) $(ROMSLICES_C) $(BLOBADDRS_C)
	@echo "blobs: $(words $(BLOB_CS)) regular + $(words $(BASEROM_CS)) baserom (fixups: $(GEN_DIR)/fixups_*.txt)"

# Stage: exe + anything it needs to run lands in build/.
stage: build
	@mkdir -p $(BUILD_DIR)
	cp -f $(BIN) $(STAGED)
	@mkdir -p $(BUILD_DIR)/assets
	@echo "staged $(STAGED)"

run: stage
	$(STAGED) --frames 60 --dump $(BUILD_DIR)/frame.ppm
	@echo "smoke frame -> $(BUILD_DIR)/frame.ppm"

# ---- Playable game: full-game binary staged into build/ with its DLLs ----
# The game exe must sit next to SDL2.dll to be runnable standalone on Windows.
STAGED_GAME := $(BUILD_DIR)/pmd-red-game
SDL2_DLL := $(shell ls $(dir $(shell command -v sdl2-config))/SDL2.dll 2>/dev/null)
stage-game: $(STAGED_GAME)
$(STAGED_GAME): $(BIN_DIR)/pmd-red-game
	@mkdir -p $(BUILD_DIR)
	cp -f $(BIN_DIR)/pmd-red-game $(STAGED_GAME)
	@if [ -n "$(SDL2_DLL)" ]; then cp -f "$(SDL2_DLL)" $(BUILD_DIR)/; fi
	@if [ -f $(ROOT)/baserom.gba ]; then cp -f $(ROOT)/baserom.gba $(BUILD_DIR)/; echo "staged $(BUILD_DIR)/baserom.gba"; fi
	@echo "staged $(STAGED_GAME)"

# ---- Host tools (same tools the GBA build uses, built for host) ----
tools: $(PREPROC) $(GBAGFX_FULL)

$(PREPROC):
	@$(MAKE) -C $(ROOT)/tools/preproc

$(LIBPNG_LIB):
	@mkdir -p $(DEPS)/src
	@if [ ! -f $(DEPS)/src/libpng.tar.gz ]; then \
	  curl -sL -o $(DEPS)/src/libpng.tar.gz https://download.sourceforge.net/project/libpng/libpng16/$(LIBPNG_VER)/libpng-$(LIBPNG_VER).tar.gz; \
	fi
	@if [ ! -d $(LIBPNG_SRC) ]; then tar xzf $(DEPS)/src/libpng.tar.gz -C $(DEPS)/src; fi
	@cd $(LIBPNG_SRC) && ./configure --prefix=$(PREFIX) --disable-shared --enable-static >/dev/null && make -j8 >/dev/null && make install >/dev/null
	@echo "libpng -> $(PREFIX)"

$(GBAGFX_FULL): $(GBAGFX_PNG_DEPS)
	@mkdir -p $(BIN_DIR)
	$(CC) -O2 -std=c11 $(GBAGFX_PNG_CPPFLAGS) -I$(ROOT)/tools/gbagfx \
	  $(ROOT)/tools/gbagfx/main.c $(ROOT)/tools/gbagfx/convert_png.c $(ROOT)/tools/gbagfx/gfx.c \
	  $(ROOT)/tools/gbagfx/jasc_pal.c $(ROOT)/tools/gbagfx/lz.c $(ROOT)/tools/gbagfx/rl.c \
	  $(ROOT)/tools/gbagfx/util.c $(ROOT)/tools/gbagfx/font.c $(ROOT)/tools/gbagfx/huff.c \
	  $(GBAGFX_PNG_LDLIBS) -o $@
	@echo "built $@"

# libpng-free gbagfx (palette/lz/rl/huff only) for machines without the dep yet.
$(GBAGFX_NOPNG):
	@mkdir -p $(BIN_DIR)
	$(CC) -O2 -std=c11 -I$(ROOT)/tools/gbagfx -I$(ROOT)/platform/pc/tools \
	  $(ROOT)/tools/gbagfx/main.c $(ROOT)/tools/gbagfx/gfx.c $(ROOT)/tools/gbagfx/jasc_pal.c \
	  $(ROOT)/tools/gbagfx/lz.c $(ROOT)/tools/gbagfx/rl.c $(ROOT)/tools/gbagfx/util.c \
	  $(ROOT)/tools/gbagfx/font.c $(ROOT)/tools/gbagfx/huff.c \
	  $(ROOT)/platform/pc/tools/convert_png_stub.c -o $@

# ---- Derived assets needed to compile src/*.c on host (all gitignored) ----
# Generates every INCBIN-referenced derived tilemap/palette asset across the
# tree (graphics/ + data/): *.4bpp/.8bpp/.1bpp from .png and *.pmdpal/.gbapal
# from .pal, via gbagfx. Idempotent; ~35k files the first time. ASSET_JOBS
# controls the parallel conversion fan-out (default 1).
assets-pc: tools $(GBAGFX_FULL)
	@cd $(ROOT) && $(PYTHON) platform/pc/tools/gen_assets.py --gbagfx $(GBAGFX_FULL) --jobs $(ASSET_JOBS)

# ---- Compile check: every game source through the real preproc pipeline ----
pc-syntax: tools assets-pc
	@cd $(ROOT) && pass=0; fail=0; failed=""; \
	for f in src/*.c; do \
	  if ! $(CC) -E $(GAME_CPPFLAGS) "$$f" -o $(BIN_DIR)/pc_t.i 2>/dev/null; then fail=$$((fail+1)); failed="$$failed $$f(E)"; continue; fi; \
	  if ! $(PREPROC) $(BIN_DIR)/pc_t.i charmap.txt > $(BIN_DIR)/pc_t.p 2>/dev/null; then fail=$$((fail+1)); failed="$$failed $$f(P)"; continue; fi; \
	  if $(CC) -std=gnu89 -O2 -fsyntax-only -x c $(BIN_DIR)/pc_t.p -o /dev/null >/dev/null 2>&1; then pass=$$((pass+1)); else fail=$$((fail+1)); failed="$$failed $$f"; fi; \
	done; \
	echo "pc-syntax PASS:$$pass FAIL:$$fail"; \
	rm -f $(BIN_DIR)/pc_t.i $(BIN_DIR)/pc_t.p; \
	if [ -n "$$failed" ]; then echo "FAILED:$$failed"; exit 1; fi

clean-pc:
	rm -rf $(OBJ_DIR) $(BIN) $(STAGED) $(BUILD_DIR)/frame.ppm
